{
  "version": "1.0.0",
  "status": "partial",
  "readiness": "buildable",
  "id": "church-ministry",
  "name": "Church and Ministry Management",
  "description": "Tenant-scoped ministry public site, published sermons, event registration, giving intake, enquiries and prayer requests. Membership, attendance, volunteers, settings and full payment reconciliation remain incomplete.",
  "requiredModules": [
    "platform-identity",
    "church-ministry"
  ],
  "optionalModules": [
    "tenant-control-plane",
    "website-content",
    "notifications",
    "analytics",
    "commerce",
    "media-storage"
  ],
  "defaultRoles": [
    {
      "id": "owner",
      "label": "Ministry administrator",
      "permissions": [
        "tenant.store.read",
        "tenant.store.update",
        "tenant.churchprivate.read",
        "tenant.churchprivate.update"
      ]
    },
    {
      "id": "admin",
      "label": "Ministry administrator",
      "permissions": [
        "tenant.store.read",
        "tenant.store.update",
        "tenant.churchprivate.read",
        "tenant.churchprivate.update"
      ]
    },
    {
      "id": "contentEditor",
      "label": "Content editor",
      "permissions": [
        "tenant.store.read",
        "tenant.store.update"
      ]
    },
    {
      "id": "viewer",
      "label": "Viewer",
      "permissions": [
        "tenant.store.read"
      ]
    }
  ],
  "navigation": [
    {
      "id": "ministry-operations",
      "label": "Ministry operations",
      "module": "church-ministry",
      "path": "/admin"
    }
  ],
  "defaults": {
    "locale": "en-KE",
    "timezone": "Africa/Nairobi",
    "currency": "KES",
    "features": [
      "published-sermons",
      "events",
      "event-registration",
      "giving-intake",
      "prayer-requests",
      "contact-enquiries"
    ]
  },
  "templateIds": [
    "church-ministry"
  ]
}
