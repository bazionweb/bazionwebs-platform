{
  "version": "1.0.0",
  "status": "experimental",
  "readiness": "roadmap",
  "readinessNotes": [
    "Checkout and store administration are present, but inventory-pricing, fulfilment, and verified global payment modules do not yet have runtime manifests."
  ],
  "id": "ecommerce",
  "name": "Ecommerce",
  "description": "Reusable tenant-configurable storefront and commerce workspace for local and international sellers.",
  "requiredModules": [
    "commerce",
    "payments",
    "inventory-pricing",
    "fulfilment",
    "media-storage",
    "notifications",
    "domains-email",
    "platform-identity"
  ],
  "optionalModules": [
    "website-content",
    "page-experience",
    "search-seo-localization",
    "contacts-crm",
    "subscriptions-billing",
    "analytics",
    "integration-hub",
    "document-management"
  ],
  "defaultRoles": [
    {
      "id": "store-owner",
      "label": "Store owner",
      "permissions": [
        "commerce.*",
        "payments.*",
        "inventory.*",
        "fulfilment.*",
        "reports.read"
      ]
    },
    {
      "id": "catalog-manager",
      "label": "Catalogue manager",
      "permissions": [
        "products.*",
        "media.*"
      ]
    },
    {
      "id": "order-manager",
      "label": "Order manager",
      "permissions": [
        "orders.read",
        "orders.update",
        "fulfilment.manage"
      ]
    },
    {
      "id": "customer",
      "label": "Customer",
      "permissions": [
        "cart.self.manage",
        "orders.self.read"
      ]
    }
  ],
  "navigation": [
    {
      "id": "products",
      "label": "Products",
      "module": "commerce",
      "path": "/admin/commerce?tab=products"
    },
    {
      "id": "orders",
      "label": "Orders",
      "module": "commerce",
      "path": "/admin/commerce?tab=orders"
    },
    {
      "id": "inventory",
      "label": "Inventory",
      "module": "inventory-pricing",
      "path": "/admin/commerce?tab=products"
    },
    {
      "id": "fulfilment",
      "label": "Delivery",
      "module": "fulfilment",
      "path": "/admin/commerce?tab=settings"
    }
  ],
  "defaults": {
    "locale": "en-KE",
    "timezone": "Africa/Nairobi",
    "currency": "KES",
    "features": [
      "catalogue",
      "product-search-and-categories",
      "product-detail-pages",
      "cart",
      "checkout",
      "orders",
      "stock",
      "delivery",
      "tenant-configurable-homepage",
      "locale-and-multi-currency-price-lists",
      "mpesa-adapter"
    ]
  },
  "templateIds": [
    "ecommerce-starter",
    "ecommerce-business"
  ],
  "migrationNotes": [
    "Apply database migration 0012_ecommerce_template.sql before enabling the shop or commerce admin routes.",
    "Each tenant configures its own shop name, homepage selection, supported currencies, delivery countries and flat delivery estimates.",
    "Currency values are tenant price lists; automatic FX conversion and automatic tax calculation are not provided.",
    "Live payment support is limited to the existing M-Pesa adapter; the mock adapter is development-only. Add a verified global provider before accepting international payments."
  ]
}
