# Application image published by a trusted CI pipeline; prefer an immutable digest.
APP_IMAGE=ghcr.io/your-organization/your-store:replace-with-release-tag

# Set a tested PostgreSQL image compatible with the application migrations.
POSTGRES_IMAGE=postgres:18

# Generate unique values for every client. Store real values only in Dokploy.
POSTGRES_DB=client_store
POSTGRES_USER=client_store_app
POSTGRES_PASSWORD=replace-with-a-long-random-secret
