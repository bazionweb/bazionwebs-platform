# Copy values into the Dokploy service environment editor.
# Do not commit a real .env file or reuse credentials between clients.

# Use tested version tags or immutable digests for production.
WORDPRESS_IMAGE=wordpress:php8.3-apache
MARIADB_IMAGE=mariadb:11.4

# Generate unique values for each client deployment.
MARIADB_DATABASE=client_wp
MARIADB_USER=client_wp_user
MARIADB_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_UNIQUE_STRONG_PASSWORD
