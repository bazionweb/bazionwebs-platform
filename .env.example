# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

# Existing commerce application database role (RLS applies to tenant-owned rows).
DATABASE_URL=postgres://bazion_app:bazion_app_local_only@localhost:5432/bazion_platform
MIGRATION_DATABASE_URL=postgres://bazion_migrator:bazion_migrator_local_only@localhost:5432/bazion_platform
# Must match the latest applied migration on a dedicated tenant database.
TENANT_DATABASE_SCHEMA_VERSION=0024_commercial_platform_hardening.sql
# Production dedicated DB bindings use docker-secret://bazion-tenant-db-<tenant-uuid>.
# Mount a per-tenant JSON secret named bazion-tenant-db-<tenant-uuid> with exactly {"DATABASE_URL":"postgres://..."}
# into the API service's HOSTING_SECRET_DIRECTORY (default /run/secrets); local dev may use env://TENANT_DATABASE_<NAME>.
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
TENANT_RESOLUTION_MODE=static

# Better Auth runtime uses the auth schema and has DML-only access.
AUTH_DATABASE_URL=postgres://bazion_auth_runtime:bazion_auth_local_only@localhost:5432/bazion_platform
# Better Auth schema migrations use the migrator role; the client sets search_path=auth.
AUTH_MIGRATION_DATABASE_URL=postgres://bazion_migrator:bazion_migrator_local_only@localhost:5432/bazion_platform

# Separate narrow tenant-directory read and provisioning roles.
TENANT_RESOLVER_DATABASE_URL=postgres://bazion_tenant_resolver:bazion_tenant_resolver_local_only@localhost:5432/bazion_platform
TENANT_PROVISIONER_DATABASE_URL=postgres://bazion_tenant_provisioner:bazion_tenant_provisioner_local_only@localhost:5432/bazion_platform
PRODUCT_PROVISIONER_DATABASE_URL=postgres://bazion_product_provisioner:bazion_product_provisioner_local_only@localhost:5432/bazion_platform
# Commercial-to-platform machine auth & signed status callbacks (configure together when enabled).
# Keep false until the platform's durable provisioning saga is deployed and ready to process accepted commands.
COMMERCIAL_PROVISIONING_ENABLED=false
COMMERCIAL_PROVISIONING_WORKER_ENABLED=false
# COMMERCIAL_PROVISIONING_COMMAND_SECRET=replace-with-32-char-random-secret
# Optional comma-separated previous secrets for zero-downtime HMAC key rotation (each >=32 chars).
# COMMERCIAL_PROVISIONING_COMMAND_PREVIOUS_SECRETS=
# COMMERCIAL_PROVISIONING_COMMAND_ISSUER=bazionweb
# COMMERCIAL_PROVISIONING_COMMAND_AUDIENCE=bazion-platform:commercial-provisioning
# COMMERCIAL_PROVISIONING_CALLBACK_URL=http://localhost:3001/api/v1/webhooks/platform/provisioning-status
# COMMERCIAL_PROVISIONING_CALLBACK_SIGNING_SECRET=replace-with-32-char-random-secret
COMMERCIAL_PROVISIONING_PILOT_MODE=disabled
# COMMERCIAL_PROVISIONING_CANARY_CUSTOMERS=
# COMMERCIAL_PROVISIONING_ALLOWED_OFFERS=
COMMERCIAL_PROVISIONING_HOSTING_MUTATIONS_ENABLED=false
COMMERCIAL_PROVISIONING_LEGACY_FALLBACK_ENABLED=true
COMMERCIAL_PROVISIONING_DUAL_READ_RECONCILIATION_ENABLED=true
# Absolute directory + canonical Base64-encoded 32-byte AES-256-GCM key for sealed lifecycle export archives.
# Both are REQUIRED in production when COMMERCIAL_PROVISIONING_ENABLED=true.
# PRIVATE_ARCHIVE_DIR=/var/lib/bazion-platform/private-archives
# PRIVATE_ARCHIVE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
NOTIFICATION_ENQUEUER_DATABASE_URL=postgres://bazion_notification_enqueuer:bazion_notification_enqueuer_local_only@localhost:5432/bazion_platform
NOTIFICATION_WORKER_DATABASE_URL=postgres://bazion_notification_worker:bazion_notification_worker_local_only@localhost:5432/bazion_platform
# Development-only example key. Generate a fresh key for every real environment.
NOTIFICATION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
DEFAULT_TENANT_CURRENCY=KES

BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=dev-only-replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:4000,http://localhost:4100
AUTH_APP_URL=http://localhost:3100
PLATFORM_CONSOLE_URL=http://localhost:3001
COMMERCIAL_PORTAL_URL=http://localhost:3000
# OIDC Authority & BFF configuration (OIDC_ISSUER + OIDC_SIGNING_PRIVATE_KEY_PEM are required in production)
# OIDC_ISSUER=http://localhost:4100
# OIDC_SIGNING_PRIVATE_KEY_PEM=
# OIDC_SIGNING_KEY_ID=
# OIDC_BFF_CLIENT_ID=bazion-bff-platform
# OIDC_BFF_CLIENT_SECRET=
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# The standalone notification worker requires a real SMTP endpoint before it starts.
# For local testing, use a disposable SMTP sink (for example Mailpit) and never real client mailboxes.
NOTIFICATION_SMTP_HOST=localhost
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_REQUIRE_TLS=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=Bazion Web <noreply@example.test>
NOTIFICATION_WORKER_BATCH_SIZE=5
NOTIFICATION_WORKER_IDLE_MS=1000

API_BASE_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:4000,http://localhost:4100
PUBLIC_STOREFRONT_URL=http://localhost:3100
# Local uploads use a private temporary directory. Production must use an S3-compatible bucket (Cloudflare R2 works).
MEDIA_STORAGE_DRIVER=local
# MEDIA_STORAGE_LOCAL_DIRECTORY=D:/bazion-media
# For R2, region is "auto" and endpoint is https://<account-id>.r2.cloudflarestorage.com.
# Use a public custom domain/CDN for MEDIA_STORAGE_PUBLIC_BASE_URL; keep the bucket access key server-side.
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_STORAGE_ENDPOINT=
# MEDIA_STORAGE_REGION=auto
# MEDIA_STORAGE_BUCKET=
# MEDIA_STORAGE_ACCESS_KEY_ID=
# MEDIA_STORAGE_SECRET_ACCESS_KEY=
# MEDIA_STORAGE_PUBLIC_BASE_URL=https://media.example.org
PAYMENT_PROVIDER=mock
DEV_PAYMENT_SECRET=local-dev-only-change-me
# Set PAYMENT_PROVIDER=mpesa for M-Pesa commerce checkout in development/sandbox.
# Church donation STK Push also uses these credentials when configured.
MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_BUSINESS_SHORT_CODE=
# MPESA_PASSKEY=
# Set the callback base to the public API URL; the API derives the church and commerce callback paths.
# MPESA_CALLBACK_URL=https://api.example.com/v1/public/church/donations/mpesa-callback
POSTGRES_ADMIN_PASSWORD=bazion_admin_local_only
BAZION_APP_PASSWORD=bazion_app_local_only
BAZION_MIGRATOR_PASSWORD=bazion_migrator_local_only
BAZION_AUTH_PASSWORD=bazion_auth_local_only
BAZION_TENANT_RESOLVER_PASSWORD=bazion_tenant_resolver_local_only
BAZION_TENANT_PROVISIONER_PASSWORD=bazion_tenant_provisioner_local_only
BAZION_NOTIFICATION_ENQUEUER_PASSWORD=bazion_notification_enqueuer_local_only
BAZION_NOTIFICATION_WORKER_PASSWORD=bazion_notification_worker_local_only
BAZION_HOSTING_RECONCILER_PASSWORD=bazion_hosting_reconciler_local_only
BAZION_PRODUCT_PROVISIONER_PASSWORD=bazion_product_provisioner_local_only
