{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "API_BASE_URL"
  ],
  "globalPassThroughEnv": [
    "PORT",
    "LOG_LEVEL",
    "DATABASE_URL",
    "DEFAULT_TENANT_ID",
    "TENANT_RESOLUTION_MODE",
    "CORS_ORIGINS",
    "PUBLIC_STOREFRONT_URL",
    "PAYMENT_PROVIDER",
    "DEV_PAYMENT_SECRET",
    "MIGRATION_DATABASE_URL",
    "AUTH_DATABASE_URL",
    "AUTH_MIGRATION_DATABASE_URL",
    "TENANT_RESOLVER_DATABASE_URL",
    "TENANT_PROVISIONER_DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "AUTH_APP_URL",
    "AUTH_REQUIRE_EMAIL_VERIFICATION",
    "NOTIFICATION_ENQUEUER_DATABASE_URL",
    "NOTIFICATION_WORKER_DATABASE_URL",
    "NOTIFICATION_ENCRYPTION_KEY",
    "NOTIFICATION_SMTP_HOST",
    "NOTIFICATION_SMTP_PORT",
    "NOTIFICATION_SMTP_SECURE",
    "NOTIFICATION_SMTP_REQUIRE_TLS",
    "NOTIFICATION_SMTP_REQUIRE_AUTH",
    "NOTIFICATION_SMTP_USER",
    "NOTIFICATION_SMTP_PASSWORD",
    "NOTIFICATION_EMAIL_FROM",
    "NOTIFICATION_WORKER_BATCH_SIZE",
    "NOTIFICATION_WORKER_IDLE_MS",
    "DEFAULT_TENANT_CURRENCY",
    "TRUSTED_PROXY_ADDRESSES"
  ]
}
