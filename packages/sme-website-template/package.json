{
  "name": "@bazion/sme-website-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --fsModuleCachePath .vitest-cache"
  },
  "dependencies": {
    "@bazion/ui": "workspace:*",
    "@bazion/website-contracts": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": { "react": ">=19" },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
