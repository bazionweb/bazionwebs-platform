{
  "name": "@bazion/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./recovery-ui": { "types": "./dist/recovery-ui.d.ts", "import": "./dist/recovery-ui.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "pnpm --filter @bazion/notifications build && tsx scripts/migrate.ts",
    "platform:create-admin": "tsx ../../scripts/create-platform-admin.ts",
    "test": "vitest run src --fsModuleCachePath .vitest-cache"
  },
  "dependencies": {
    "@bazion/notifications": "workspace:*",
    "@bazion/platform-identity": "workspace:*",
    "better-auth": "1.7.17",
    "pg": "^8.23.1"
  },
  "peerDependencies": { "react": ">=19" },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/node": "^26.6.6",
    "react": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@types/pg": "^8.15.5"
  }
}
