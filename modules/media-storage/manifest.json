{
  "id": "media-storage",
  "name": "Tenant media storage adapters",
  "version": "1.0.0",
  "owner": "platform",
  "status": "stable",
  "entrypoints": {
    "adapter": "packages/storage",
    "api": "apps/api/src/modules/media"
  },
  "implementation": { "mode": "hybrid", "packageName": "@bazion/storage" },
  "tenantModel": "tenant-owned",
  "permissions": [
    { "resource": "media", "actions": ["read", "create", "delete"] }
  ],
  "tables": [
    { "name": "tenant_media_assets", "owner": "media-storage", "tenantScoped": true, "rls": "forced", "migration": "0034_complete_partial_modules.sql" }
  ],
  "migrations": ["0034_complete_partial_modules.sql"],
  "dependencies": ["platform-identity"],
  "operations": {
    "logs": false,
    "metrics": false,
    "retention": "Object lifecycle and tenant data retention are controlled by storage configuration and the consuming tenant module.",
    "recovery": "Restore media from the configured object-store backup or replication policy and verify tenant prefixes before reopening uploads.",
    "enableDisable": "Authorization is enforced by consuming module routes; disable those routes before disabling storage, and preserve tenant export and retention access."
  },
  "events": [],
  "jobs": [],
  "providers": ["Local filesystem", "S3-compatible object storage"],
  "tests": [
    "packages/storage/src/image-upload.test.ts",
    "packages/storage/src/image-optimization.test.ts",
    "apps/api/src/modules/media/routes.test.ts"
  ],
  "docs": ["docs/module-development-contract.md"]
}
