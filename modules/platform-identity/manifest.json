{
  "id": "platform-identity",
  "name": "Platform identity and tenant access",
  "version": "1.0.0",
  "owner": "platform",
  "status": "partial",
  "entrypoints": {
    "domain": "packages/platform-identity",
    "api": "packages/auth"
  },
  "implementation": { "mode": "workspace-package", "packageName": "@bazion/platform-identity" },
  "tenantModel": "mixed",
  "tables": [
    { "name": "tenants", "owner": "platform-identity", "tenantScoped": false, "rls": "not-applicable", "migration": "0001_initial.sql" },
    { "name": "tenant_domains", "owner": "platform-identity", "tenantScoped": false, "rls": "not-applicable", "migration": "0002_auth_tenant_registry.sql" },
    { "name": "platform_members", "owner": "platform-identity", "tenantScoped": false, "rls": "not-applicable", "migration": "0002_auth_tenant_registry.sql" },
    { "name": "tenant_module_entitlements", "owner": "platform-identity", "tenantScoped": false, "rls": "not-applicable", "migration": "0007_platform_tenant_control_plane.sql" },
    { "name": "tenant_platform_settings", "owner": "platform-identity", "tenantScoped": false, "rls": "not-applicable", "migration": "0007_platform_tenant_control_plane.sql" },
    { "name": "tenant_database_bindings", "owner": "platform-identity", "tenantScoped": false, "rls": "not-applicable", "migration": "0013_tenant_database_routing.sql" }
  ],
  "migrations": ["0001_initial.sql", "0002_auth_tenant_registry.sql", "0006_tenant_lifecycle.sql", "0007_platform_tenant_control_plane.sql", "0013_tenant_database_routing.sql"],
  "permissions": [
    {
      "resource": "organization",
      "actions": [
        "update"
      ]
    },
    {
      "resource": "member",
      "actions": [
        "create",
        "update",
        "delete"
      ]
    },
    {
      "resource": "invitation",
      "actions": [
        "create",
        "cancel"
      ]
    }
  ],
  "dependencies": [],
  "operations": {
    "logs": true,
    "metrics": false,
    "retention": "Security events are retained in the platform audit trail; credentials and personal contact data are excluded.",
    "recovery": "Restore the auth schema and tenant identity mappings from verified backups; re-run versioned Better Auth migrations.",
    "enableDisable": "Required platform module; disable only through an approved maintenance procedure."
  },
  "events": [
    "identity.session.created",
    "identity.member.role.updated"
  ],
  "jobs": [],
  "providers": [
    "Better Auth"
  ],
  "tests": [
    "packages/auth/src"
  ],
  "docs": [
    "docs/architecture/authentication-and-tenant-isolation.md",
    "docs/adr/0006-platform-identity-ports.md"
  ]
}
