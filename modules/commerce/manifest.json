{
  "id": "commerce",
  "name": "Commerce authorization surface",
  "version": "1.0.0",
  "owner": "commerce",
  "status": "partial",
  "entrypoints": {
    "domain": "packages/commerce-domain",
    "api": "apps/api/src/modules/commerce"
  },
  "implementation": { "mode": "hybrid", "packageName": "@bazion/commerce-domain" },
  "tenantModel": "tenant-owned",
  "tables": [
    { "name": "products", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" },
    { "name": "commerce_store_settings", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0012_ecommerce_template.sql" },
    { "name": "carts", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" },
    { "name": "cart_items", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" },
    { "name": "orders", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" },
    { "name": "order_items", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" },
    { "name": "payment_attempts", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0010_commerce_mpesa_callbacks.sql" },
    { "name": "webhook_events", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" },
    { "name": "idempotency_records", "owner": "commerce", "tenantScoped": true, "rls": "forced", "migration": "0001_initial.sql" }
  ],
  "migrations": [
    "0001_initial.sql",
    "0010_commerce_mpesa_callbacks.sql",
    "0012_ecommerce_template.sql",
    "0015_commerce_inventory_reservation_guard.sql"
  ],
  "permissions": [
    {
      "resource": "product",
      "actions": [
        "read",
        "create",
        "update",
        "delete"
      ]
    },
    {
      "resource": "order",
      "actions": [
        "read",
        "update",
        "refund"
      ]
    }
  ],
  "dependencies": [
    "platform-identity"
  ],
  "operations": {
    "logs": true,
    "metrics": true,
    "retention": "Business record retention is tenant-configurable and subject to applicable accounting requirements.",
    "recovery": "Restore tenant-scoped database backups and verify foreign-key/RLS constraints before reopening commerce operations.",
    "enableDisable": "Disable checkout before disabling commerce routes; retain export and data-retention controls."
  },
  "events": [
    "commerce.order.created",
    "commerce.order.paid"
  ],
  "jobs": [],
  "providers": [
    "Development-only mock payment provider",
    "Safaricom Daraja M-Pesa STK Push with token-protected callback verification"
  ],
  "tests": [
    "apps/api/src/modules/commerce",
    "packages/commerce-domain"
  ],
  "docs": [
    "docs/product-architecture.md"
  ]
}
