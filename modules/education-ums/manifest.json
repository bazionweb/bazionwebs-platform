    { "name": "education_regulatory_evidence", "owner": "education-ums", "tenantScoped": true, "rls": "forced", "migration": "0030_education_institution_contacts_evidence.sql" },
    { "name": "education_study_centers", "owner": "education-ums", "tenantScoped": true, "rls": "forced", "migration": "0034_complete_partial_modules.sql" },
    { "name": "education_staff", "owner": "education-ums", "tenantScoped": true, "rls": "forced", "migration": "0034_complete_partial_modules.sql" },
