  "events": [],
  "jobs": [],
  "tests": [
    "packages/education-ums/src/index.test.tsx",
    "apps/api/src/modules/education/data-routes.test.ts"
  ],
  "docs": [],
  "operations": {
    "logs": true,
    "metrics": false,
