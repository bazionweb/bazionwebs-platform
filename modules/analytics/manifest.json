{
  "id": "analytics",
  "name": "Analytics",
  "version": "1.0.0",
  "owner": "analytics",
  "status": "stable",
  "entrypoints": {
    "domain": "packages/analytics",
    "api": "apps/api/src/modules/analytics"
  },
  "implementation": { "mode": "hybrid", "packageName": "@bazion/analytics" },
  "tenantModel": "tenant-owned",
  "tables": [
    { "name": "analytics_events", "owner": "analytics", "tenantScoped": true, "rls": "forced", "migration": "0034_complete_partial_modules.sql" },
    { "name": "analytics_policies", "owner": "analytics", "tenantScoped": true, "rls": "forced", "migration": "0034_complete_partial_modules.sql" }
  ],
  "migrations": ["0034_complete_partial_modules.sql"],
  "permissions": [
    {
      "resource": "analytics",
      "actions": [
        "read",
        "export",
        "delete"
      ]
    }
  ],
  "dependencies": [
    "platform-identity"
  ],
  "operations": {
    "logs": true,
    "metrics": true,
    "retention": "Use documented event retention and tenant export/delete controls via @bazion/api db:expire-analytics-events.",
    "recovery": "Rebuild derived aggregates from retained events where available; restore durable event data from backup.",
    "enableDisable": "Can be disabled per tenant without affecting commerce or identity."
  },
  "jobs": [
    "apps/api/scripts/expire-analytics-events.ts"
  ],
  "tests": [
    "packages/analytics/src",
    "apps/api/src/modules/analytics/routes.test.ts"
  ]
}
