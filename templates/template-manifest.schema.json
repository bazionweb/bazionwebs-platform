{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazionweb.com/schemas/template-manifest.schema.json",
  "title": "Bazion site template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "status", "implementation", "configuration"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["planned", "experimental", "partial", "stable", "deprecated"] },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "entrypoint"],
      "properties": {
        "packageName": { "type": "string", "pattern": "^@bazion/[a-z0-9-]+$" },
        "entrypoint": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourcePath", "schemaNames"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sourcePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$" },
        "schemaNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" } }
      }
    }
  }
}
