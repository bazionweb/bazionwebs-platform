{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazionweb.com/schemas/runtime-module-policy.schema.json",
  "title": "Bazion tenant module runtime policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "description", "defaultEnabled", "required", "tenantAssignable", "entitlementDependencies"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 1 },
          "defaultEnabled": { "type": "boolean" },
          "required": { "type": "boolean" },
          "tenantAssignable": { "type": "boolean" },
          "entitlementDependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
          }
        }
      }
    }
  }
}
