{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazionweb.com/schemas/commercial-offerings.schema.json",
  "title": "Bazion commercial offering catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "pricingPolicy", "interpretation", "offerings"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "source": { "type": "string", "minLength": 1 },
    "pricingPolicy": { "type": "string", "minLength": 1 },
    "interpretation": { "type": "string", "minLength": 1 },
    "offerings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "group", "kind", "moduleIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "group": { "enum": ["website-package", "ecommerce-package", "custom-systems", "hosting-plan", "care-plan", "add-on"] },
          "kind": { "enum": ["fixed-scope-service-bundle", "custom-service-bundle", "professional-service", "managed-service-plan", "provider-adapter", "module-add-on", "integration-service", "rate-card-item"] },
          "moduleIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }
        }
      }
    }
  }
}
