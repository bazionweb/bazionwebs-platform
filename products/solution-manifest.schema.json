{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazionweb.com/schemas/solution-manifest.schema.json",
  "title": "Bazion solution composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "readiness", "id", "name", "description", "requiredModules", "optionalModules", "defaultRoles", "navigation", "defaults", "templateIds"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["planned", "partial", "experimental", "stable", "deprecated"] },
    "readiness": { "enum": ["buildable", "roadmap"] },
    "readinessNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 1 },
    "requiredModules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
    "optionalModules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
    "defaultRoles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "permissions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "permissions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "navigation": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "module", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["locale", "timezone", "currency", "features"],
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "timezone": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "templateIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "migrationNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
