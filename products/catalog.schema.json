{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazionweb.com/schemas/product-catalog.schema.json",
  "title": "Bazion product capability catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedFrom", "principle", "modules", "capabilities"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedFrom": { "type": "string", "minLength": 1 },
    "principle": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "classification", "sourcePath", "status", "scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "classification": { "enum": ["module", "roadmap-capability"] },
          "sourcePath": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["implemented", "partial", "planned"] },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "group", "moduleId", "recordType"],
        "properties": {
          "id": { "type": "string", "pattern": "^BW-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 2 },
          "group": { "type": "string", "minLength": 1 },
          "moduleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "recordType": { "enum": ["capability", "provider-adapter", "platform-foundation", "solution-capability", "commercial-capability", "solution-pack"] }
        }
      }
    }
  }
}
